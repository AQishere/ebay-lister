# Copy to .env and fill in. Never commit .env.

# eBay developer app (https://developer.ebay.com/my/keys), production keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production            # production | sandbox
EBAY_MARKETPLACE=EBAY_US       # EBAY_US | EBAY_GB

# MongoDB Atlas M0
MONGODB_URI=
MONGODB_DB=ebay_lister

# LLM used for extraction, titles, specifics and descriptions
LLM_PROVIDER=groq              # groq | ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b     # list yours: python -m scripts.check_llm --models
GROQ_REASONING_EFFORT=low          # gpt-oss only: low | medium | high
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings: Voyage AI (https://dashboard.voyageai.com)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
EMBED_DIM=1024


# Exposure: same-origin frontend needs no CORS (comma-separate extra origins). API docs at /api/docs only when true.
CORS_ORIGINS=
EXPOSE_DOCS=false

# Rate limits (stored in MongoDB, shared by all serverless instances)
RATE_DRAFTS_PER_MINUTE=5
RATE_DRAFTS_PER_DAY=60
RATE_MARKET_PER_MINUTE=15
RATE_GLOBAL_DRAFTS_PER_DAY=250
